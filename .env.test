# Test Environment Configuration
NODE_ENV=test
PORT=3001
DOMAIN=localhost

# Test Database
DATABASE_URL=postgresql://pubkeymail_user:pubkeymail_dev_password@localhost:5432/pubkeymail_test
DATABASE_POOL_SIZE=5

# Test Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=pubkeymail_test:

# Test Configuration
EMAIL_RETENTION_DAYS=30
JWT_SECRET=test-jwt-secret-for-testing-only-do-not-use-in-production
JWT_EXPIRATION=3600
SESSION_DURATION=3600
AUTH_NONCE_EXPIRATION=300

# Mock Services
SMTP_PROVIDER=mock
SMTP_API_KEY=test-api-key
SMTP_WEBHOOK_SECRET=test-webhook-secret
SMTP_FROM_DOMAIN=test.example.com

# Test Blockchain (Devnet)
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SNS_PROGRAM_ID=namesLPneVptA9Z5rqUDD9tMTWEJwofgaYwp8cawRkX

# Disable external services in tests
MOCK_SMTP_PROVIDER=true
MOCK_BLOCKCHAIN_PROVIDER=false
ENABLE_METRICS=false
LOG_LEVEL=error
LOG_PRETTY_PRINT=false
