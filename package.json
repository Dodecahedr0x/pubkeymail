{
  "name": "pubkeymail",
  "version": "0.1.0",
  "description": "Blockchain-based email service with wallet authentication",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local & npm run dev:web",
    "dev:api": "tsx watch src/index.ts",
    "dev:local": "USE_LOCAL_DEV=true DOMAIN=localhost JWT_SECRET=local-dev-secret-key-min-32-chars SMTP_API_KEY=mock SMTP_WEBHOOK_SECRET=mock SMTP_FROM_DOMAIN=localhost SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com CORS_ORIGIN=http://localhost:3001 tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc",
    "build:dev": "tsc --sourceMap",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "type-check:web": "npm --prefix web run type-check",
    "type-check:all": "npm run type-check && npm run type-check:web",
    "lint": "eslint src",
    "lint:web": "npm --prefix web run lint",
    "lint:all": "npm run lint && npm run lint:web",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:rollback": "tsx src/database/migrate.ts --down",
    "migrate:create": "node-pg-migrate create --migration-file-language ts -m src/database/migrations",
    "db:reset": "tsx src/database/reset.ts",
    "db:seed": "tsx src/database/seed.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:generate:json": "tsx scripts/generate-openapi.ts --json",
    "ci": "npm run lint && npm run type-check && npm run test"
  },
  "keywords": [
    "blockchain",
    "email",
    "solana",
    "wallet",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@solana/spl-name-service": "^0.2.1",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^5.0.0",
    "bull": "^4.16.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "redis": "^4.6.11",
    "tweetnacl": "^1.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^9.39.2",
    "openapi3-ts": "^4.5.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^1.0.4",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}