{
  "name": "pubkeymail",
  "version": "0.1.0",
  "description": "Blockchain-based email service with wallet authentication",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:dev": "tsc --sourceMap",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:rollback": "tsx src/database/migrate.ts --down",
    "migrate:create": "node-pg-migrate create --migration-file-language ts -m src/database/migrations",
    "db:reset": "tsx src/database/reset.ts",
    "db:seed": "tsx src/database/seed.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:generate:json": "tsx scripts/generate-openapi.ts --json"
  },
  "keywords": [
    "blockchain",
    "email",
    "solana",
    "wallet",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@solana/spl-name-service": "^0.2.1",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^5.0.0",
    "bull": "^4.16.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "redis": "^4.6.11",
    "tweetnacl": "^1.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.55.0",
    "openapi3-ts": "^4.5.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
