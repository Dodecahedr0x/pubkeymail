{
  "name": "pubkeymail",
  "version": "0.1.0",
  "private": true,
  "description": "Blockchain-based email service with wallet authentication",
  "workspaces": [
    "api",
    "web",
    "videos"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm --prefix api run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:videos": "npm --prefix videos run preview",
    "render:video": "npm --prefix videos run render",
    "render:videos": "npm --prefix videos run render:all",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --prefix api run build",
    "build:web": "npm --prefix web run build",
    "start": "npm --prefix api run start",
    "test": "npm --prefix api run test",
    "test:watch": "npm --prefix api run test:watch",
    "test:coverage": "npm --prefix api run test:coverage",
    "type-check": "npm --prefix api run type-check && npm --prefix web run type-check",
    "lint": "npm --prefix api run lint && npm --prefix web run lint && npm --prefix videos run lint",
    "lint:fix": "npm --prefix api run lint:fix && npm --prefix web run lint:fix && npm --prefix videos run lint:fix",
    "format": "npm --prefix api run format",
    "format:check": "npm --prefix api run format:check",
    "migrate": "npm --prefix api run migrate",
    "migrate:rollback": "npm --prefix api run migrate:rollback",
    "migrate:create": "npm --prefix api run migrate:create",
    "db:reset": "npm --prefix api run db:reset",
    "db:seed": "npm --prefix api run db:seed",
    "openapi:generate": "npm --prefix api run openapi:generate",
    "openapi:generate:json": "npm --prefix api run openapi:generate:json",
    "ci": "npm run lint && npm run type-check && npm run test"
  },
  "keywords": [
    "blockchain",
    "email",
    "solana",
    "wallet",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}