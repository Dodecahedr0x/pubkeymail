# Application Configuration
NODE_ENV=development
PORT=3000
DOMAIN=localhost
API_VERSION=v1

# Database Configuration
# CRITICAL: PostgreSQL must use case-sensitive collation (C or POSIX)
DATABASE_URL=postgresql://pubkeymail_user:pubkeymail_dev_password@localhost:5432/pubkeymail
DATABASE_POOL_SIZE=20
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=10000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=pubkeymail:
REDIS_DEFAULT_TTL=3600

# Email Retention Policy
# Number of days to retain emails for unregistered users
EMAIL_RETENTION_DAYS=30
# Run cleanup job at this hour (0-23, UTC)
CLEANUP_JOB_HOUR=2

# SMTP Provider Configuration
# Options: sendgrid, postmark, mailgun
SMTP_PROVIDER=sendgrid
SMTP_API_KEY=your-smtp-api-key-here
SMTP_WEBHOOK_SECRET=your-webhook-secret-here
SMTP_FROM_DOMAIN=yourdomain.tld
SMTP_WEBHOOK_PATH=/webhooks/inbound

# SendGrid specific (if using SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_INBOUND_PARSE_WEBHOOK_URL=/webhooks/inbound

# Postmark specific (if using Postmark)
POSTMARK_API_KEY=your-postmark-api-key
POSTMARK_INBOUND_WEBHOOK_URL=/webhooks/inbound

# Mailgun specific (if using Mailgun)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.tld

# Blockchain Configuration - Solana
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Mainnet: https://api.mainnet-beta.solana.com
# Devnet: https://api.devnet.solana.com
# Testnet: https://api.testnet.solana.com

# Solana Name Service (SNS) Configuration
SNS_PROGRAM_ID=namesLPneVptA9Z5rqUDD9tMTWEJwofgaYwp8cawRkX
SNS_CACHE_TTL=3600

# Blockchain Configuration - Ethereum
ETHEREUM_RPC_ENDPOINT=https://eth-mainnet.g.alchemy.com/v2/your-api-key
ETHEREUM_CHAIN_ID=1
ENS_CACHE_TTL=3600

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=86400
# Session duration in seconds (86400 = 24 hours)
SESSION_DURATION=86400
# Nonce expiration for challenge-response (300 = 5 minutes)
AUTH_NONCE_EXPIRATION=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS_PER_HOUR=1000
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EMAIL_SEND_FREE_TIER=50
RATE_LIMIT_EMAIL_SEND_PAID_TIER=500

# Email Limits
MAX_EMAIL_SIZE_MB=25
MAX_ATTACHMENT_SIZE_MB=10
MAX_ATTACHMENTS_PER_EMAIL=10

# Payment Configuration - Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_ID_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_ID_YEARLY=price_your-yearly-price-id

# Payment Configuration - Solana Pay
SOLANA_PAY_MERCHANT_WALLET=YourMerchantWalletPublicKeyHere
SOLANA_PAY_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_PAY_MONTHLY_PRICE_USDC=10.00
SOLANA_PAY_YEARLY_PRICE_USDC=100.00

# Logging
LOG_LEVEL=info
# Options: trace, debug, info, warn, error, fatal
LOG_PRETTY_PRINT=true

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,yourdomain.tld
HELMET_CSP_ENABLED=true

# Monitoring & Observability
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# Feature Flags
ENABLE_EMAIL_ENCRYPTION=true
ENABLE_FORWARDING_FILTERS=true
ENABLE_SPAM_FILTERING=false

# Development & Testing
ENABLE_DEBUG_ROUTES=false
MOCK_SMTP_PROVIDER=false
MOCK_BLOCKCHAIN_PROVIDER=false
TEST_WALLET_PRIVATE_KEY=your-test-wallet-private-key-for-testing-only
